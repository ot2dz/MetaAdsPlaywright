# MetaAdsPlaywright configuration

# Optional proxy rotation (comma-separated).
# Each entry: [scheme://][user:pass@]host:port
# You can also put one proxy per line in proxies.txt next to this file.
# META_SCRAPER_PROXIES=http://user:pass@host:port,socks5://host:port

# Optional proactive throttle (requests/sec). Off by default (reactive backoff).
# META_RATE_PER_SEC=2
# META_RATE_BURST=8

# Dashboard (server side): required to accept pushed ads via POST /api/ingest.
# INGEST_TOKEN=change-me

# Set to false on a host without Chromium (e.g. Coolify): the dashboard becomes
# display/ingest-only and queues scrape jobs for a remote worker instead.
# SCRAPE_ENABLED=false

# Optional distinct token for the worker agent (defaults to INGEST_TOKEN).
# WORKER_TOKEN=change-me
