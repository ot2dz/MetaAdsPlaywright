# MetaAdsPlaywright configuration

# Optional proxy rotation (comma-separated).
# Each entry: [scheme://][user:pass@]host:port
# You can also put one proxy per line in proxies.txt next to this file.
# META_SCRAPER_PROXIES=http://user:pass@host:port,socks5://host:port

# Optional proactive throttle (requests/sec). Off by default (reactive backoff).
# META_RATE_PER_SEC=2
# META_RATE_BURST=8
